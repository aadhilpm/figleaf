 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n\t.mf { font-family: inherit; color: #1f2937; }\n\t.mf-head { text-align: center; margin-bottom: 14px; }\n\t.mf-head h2 { margin: 0; color: #1f4e79; letter-spacing: 1px; font-weight: 800; }\n\t.mf-head div { font-weight: 700; font-size: 11px; letter-spacing: 1px; }\n\t.mf table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }\n\t.mf td, .mf th { border: 1px solid #b8c7d9; padding: 6px 10px; font-size: 12px; }\n\t.mf .k { background: #f5f7fa; color: #1f4e79; font-weight: 700; width: 28%; }\n\t.mf th { background: #1f4e79; color: #fff; text-align: center; }\n\t.mf .v { text-align: center; font-weight: 700; font-size: 13px; }\n\t.mf-garment { page-break-inside: avoid; }\n\t.mf-foot { text-align: center; font-size: 10px; color: #666; margin-top: 8px; }\n</style>\n<div class=\"mf\">\n{%- for g in doc.get(\"garments\") %}\n<div class=\"mf-garment\" {% if not loop.first %}style=\"page-break-before: always;\"{% endif %}>\n\t<div class=\"mf-head\">\n\t\t<h2>{{ (g.garment or \"\") | upper }}</h2>\n\t\t<div>{{ _(\"MEASUREMENT FORM\") }}</div>\n\t</div>\n\t<table>\n\t\t<tr><td class=\"k\">{{ _(\"Customer\") }}</td><td>{{ doc.customer_name or doc.customer }}</td></tr>\n\t\t<tr><td class=\"k\">{{ _(\"Person / Staff Name\") }}</td><td>{{ doc.person_name }}{% if doc.employee_code %} ({{ doc.employee_code }}){% endif %}{% if doc.designation %}, {{ doc.designation }}{% endif %}</td></tr>\n\t\t<tr><td class=\"k\">{{ _(\"Date\") }}</td><td>{{ frappe.utils.formatdate(doc.measurement_date) }}</td></tr>\n\t\t<tr><td class=\"k\">{{ _(\"Order / Ref. No.\") }}</td><td>{{ doc.ref_no or doc.sales_order or \"\" }}</td></tr>\n\t</table>\n\t<table>\n\t\t<tr><th style=\"width:45%\">{{ _(\"Measurement\") }}</th><th>{{ _(\"Value / Size\") }} ({{ doc.unit }})</th><th>{{ _(\"Notes\") }}</th></tr>\n\t\t{%- for r in doc.get(\"measurement_values\") if r.garment == g.garment %}\n\t\t<tr><td class=\"k\" style=\"font-weight:400;color:#1f2937\">{{ _(r.measurement_type) }}</td><td class=\"v\">{{ r.value or \"\" }}</td><td>{{ r.notes or \"\" }}</td></tr>\n\t\t{%- endfor %}\n\t</table>\n\t<table>\n\t\t<tr><td class=\"k\" style=\"width:20%;height:50px;vertical-align:top\">{{ _(\"Remarks\") }}</td><td style=\"vertical-align:top\">{{ doc.remarks or \"\" }}</td></tr>\n\t</table>\n\t<div class=\"mf-foot\">{{ doc.name }}{% if doc.measured_by %} \u00b7 {{ _(\"Measured by\") }} {{ frappe.db.get_value(\"User\", doc.measured_by, \"full_name\") or doc.measured_by }}{% endif %}</div>\n</div>\n{%- endfor %}\n</div>\n",
