   "fieldname": "help_html",
   "fieldtype": "HTML",
   "options": "<p class='text-muted small'>Rules for recording customer measurements in ERPNext and in the Measurement Entry mobile app. Garments and their measurements are set up in <a href='/app/garment-template'>Garment Template</a>, measurement names in <a href='/app/measurement-type'>Measurement Type</a> and units in <a href='/app/measurement-unit'>Measurement Unit</a>. Phones pick up changes on their next sync.</p>"
  },
